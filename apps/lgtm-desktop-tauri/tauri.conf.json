{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lgtm-desktop-tauri",
  "version": "0.1.0",
  "identifier": "io.difflab.lgtm.desktop.tauri",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "lgtm-desktop-tauri",
        "width": 800,
        "height": 600,
        "theme": "Dark",
        "titleBarStyle": "Transparent",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
