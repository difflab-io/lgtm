# Bun dependencies and generated output
node_modules/
**/node_modules/
bun.lock
**/bun.lock
dist/
**/dist/
**/dist-e2e/
.output/
**/.output/
.svelte-kit/
**/.svelte-kit/
build/
**/build/
coverage/
**/coverage/

# Browser test artifacts
**/test-results/
**/playwright-report/

# Keep the root dependency graph reproducible
!/bun.lock

# Mise local state
.mise/
**/.mise/
.mise.local.toml

# Local configuration and secrets
.env
.env.*
!.env.example

# Agent and editor state
.claude/
.codevoyant
.pi/
.idea/
.vscode/
*.swp

# Operating system files
.DS_Store

# Rust build artifacts
target/
**/target/

# Generated CLI package contents (included explicitly by Cargo)
/apps/lgtm-cli/bundle/
/apps/lgtm-cli/.bundle-stage/

# Generated Neovim help index
/apps/lgtm.nvim/doc/tags

# Generated E2E CLI outputs
/e2e/outputs/
