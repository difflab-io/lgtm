#!/usr/bin/env bash
# Run a test command against supplied PostgreSQL or an isolated PostgreSQL 17 container.
set -euo pipefail
if [[ -n "${LGTM_TEST_POSTGRES_URL:-}" ]]; then
  exec "$@"
fi
command -v docker >/dev/null || { echo "PostgreSQL tests require LGTM_TEST_POSTGRES_URL or Docker" >&2; exit 1; }
container=$(docker run --rm -d -p 127.0.0.1::5432 -e POSTGRES_USER=lgtm -e POSTGRES_PASSWORD=lgtm-test -e POSTGRES_DB=lgtm_test postgres:17)
trap 'docker rm -f "$container" >/dev/null 2>&1 || true' EXIT
ready=false
for _ in {1..60}; do
  if docker exec "$container" pg_isready -h 127.0.0.1 -U lgtm -d lgtm_test >/dev/null 2>&1; then ready=true; break; fi
  sleep 1
done
if [[ "$ready" != true ]]; then docker logs "$container" >&2; exit 1; fi
address=$(docker port "$container" 5432/tcp)
export LGTM_TEST_POSTGRES_URL="postgres://lgtm:lgtm-test@${address}/lgtm_test"
"$@"
